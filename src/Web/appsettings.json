{
  "Settings": {
    "Environment": "Production",
    "Agent": {
      "ProjectEndpoint": "https://gislefoss-aifoundry.services.ai.azure.com/api/projects/gislefoss-aifoundryproj",
      "ModelDeploymentName": "chat",
      "AgentName": "Gislefoss"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Debug"
      }
    ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:8087"
      }
    }
  }
}
